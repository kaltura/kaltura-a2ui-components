[
  {
    "component": "KalturaPlayer",
    "description": "Bound entry id, then the data model changes.",
    "messages": [
      {
        "version": "v0.9",
        "createSurface": {
          "surfaceId": "s",
          "catalogId": "https://kaltura.github.io/a2ui/v1/catalog.json"
        }
      },
      {
        "version": "v0.9",
        "updateDataModel": {
          "surfaceId": "s",
          "path": "/",
          "value": {
            "entryId": "0_abc"
          }
        }
      },
      {
        "version": "v0.9",
        "updateComponents": {
          "surfaceId": "s",
          "components": [
            {
              "id": "root",
              "component": "KalturaPlayer",
              "partnerId": 1,
              "uiconfId": 2,
              "entryId": {
                "path": "/entryId"
              },
              "autoplay": true,
              "muted": true
            }
          ]
        }
      }
    ],
    "expect": {
      "selector": ".kaltura-player-container [role=\"region\"]",
      "textContains": [
        "0_abc"
      ]
    },
    "after": {
      "messages": [
        {
          "version": "v0.9",
          "updateDataModel": {
            "surfaceId": "s",
            "path": "/entryId",
            "value": "0_def"
          }
        }
      ],
      "expect": {
        "textContains": [
          "0_def"
        ]
      }
    }
  },
  {
    "component": "KalturaFlashcards",
    "description": "Bound deck title, then the data model changes.",
    "messages": [
      {
        "version": "v0.9",
        "createSurface": {
          "surfaceId": "s",
          "catalogId": "https://kaltura.github.io/a2ui/v1/catalog.json"
        }
      },
      {
        "version": "v0.9",
        "updateDataModel": {
          "surfaceId": "s",
          "path": "/",
          "value": {
            "deck": {
              "title": "Biology"
            }
          }
        }
      },
      {
        "version": "v0.9",
        "updateComponents": {
          "surfaceId": "s",
          "components": [
            {
              "id": "root",
              "component": "KalturaFlashcards",
              "title": {
                "path": "/deck/title"
              },
              "cards": [
                {
                  "title": "Cell",
                  "content": "The basic unit of life."
                }
              ]
            }
          ]
        }
      }
    ],
    "expect": {
      "textContains": [
        "Biology",
        "Cell"
      ]
    },
    "after": {
      "messages": [
        {
          "version": "v0.9",
          "updateDataModel": {
            "surfaceId": "s",
            "path": "/deck/title",
            "value": "Chemistry"
          }
        }
      ],
      "expect": {
        "textContains": [
          "Chemistry"
        ]
      }
    }
  },
