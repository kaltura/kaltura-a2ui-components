{
  "name": "@kaltura/a2ui-react",
  "version": "0.1.4",
  "description": "Kaltura's A2UI Experience Components (Player, Flashcards, Media Manager) as a reusable, CDN-publishable catalog for any A2UI client.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaltura/kaltura-a2ui-components.git"
  },
  "keywords": [
    "a2ui",
    "kaltura",
    "agent",
    "ui",
    "player",
    "components"
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/adapters/react/index.d.ts",
      "import": "./dist/kaltura-react.mjs"
    },
    "./webcomponent": {
      "default": "./dist/kaltura-wc.js"
    },
    "./catalog": "./src/catalog/kaltura_catalog.json"
  },
  "module": "./dist/kaltura-react.mjs",
  "types": "./dist/types/adapters/react/index.d.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run build:react && npm run build:wc && npm run build:types",
    "build:react": "BUILD_TARGET=react vite build",
    "build:wc": "BUILD_TARGET=webcomponent vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:package": "publint && attw --pack . --profile esm-only",
    "size": "size-limit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@a2ui/markdown-it": "^0.1.2",
    "@a2ui/react": "^0.11.1",
    "@a2ui/web_core": "^0.11.0",
    "@types/topojson-client": "^3.1.5",
    "@visx/axis": "^4.0.0-alpha.11",
    "@visx/curve": "^4.0.0-alpha.11",
    "@visx/geo": "^4.0.0-alpha.11",
    "@visx/gradient": "^4.0.0-alpha.11",
    "@visx/grid": "^4.0.0-alpha.11",
    "@visx/group": "^4.0.0-alpha.11",
    "@visx/heatmap": "^4.0.0-alpha.11",
    "@visx/hierarchy": "^4.0.0-alpha.11",
    "@visx/legend": "^4.0.0-alpha.11",
    "@visx/point": "^4.0.0-alpha.11",
    "@visx/responsive": "^4.0.0-alpha.11",
    "@visx/sankey": "^4.0.0-alpha.11",
    "@visx/scale": "^4.0.0-alpha.11",
    "@visx/shape": "^4.0.0-alpha.11",
    "@visx/text": "^4.0.0-alpha.11",
    "@visx/tooltip": "^4.0.0-alpha.11",
    "@visx/wordcloud": "^4.0.0-alpha.11",
    "@visx/xychart": "^4.0.0-alpha.11",
    "topojson-client": "^3.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@size-limit/file": "^14.2.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^29.0.0",
    "publint": "^0.3.25",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "size-limit": "^14.2.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.0.10",
    "vite-plugin-css-injected-by-js": "^3.5.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "markdown-it": "^14.3.1",
    "linkify-it": "^5.0.2"
  }
}
