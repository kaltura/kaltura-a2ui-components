{
  "name": "@kaltura/a2ui-react",
  "version": "0.6.0",
  "private": true,
  "description": "Kaltura Experience Components for A2UI: Player, Flashcards, Media Manager, Recorder, Captions Editor, Analytics, Genie, Content Lab, Avatar, VOD Avatar, Agents Widget and Chart. A React catalog for A2UI clients and a self-contained web component bundle for plain HTML pages.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaltura/kaltura-a2ui-components.git"
  },
  "keywords": [
    "a2ui",
    "kaltura",
    "agent",
    "ui",
    "player",
    "components"
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/adapters/react/index.d.ts",
      "import": "./dist/kaltura-react.mjs"
    },
    "./webcomponent": {
      "types": "./dist/types/adapters/webcomponent/index.d.ts",
      "default": "./dist/kaltura-wc.js"
    },
    "./catalog": {
      "default": "./src/catalog/kaltura_catalog.json"
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/kaltura-react.mjs",
  "types": "./dist/types/adapters/react/index.d.ts",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples",
    "build": "npm run build:react && npm run build:wc && npm run build:types && npm run build:notices",
    "build:react": "BUILD_TARGET=react vite build",
    "build:wc": "BUILD_TARGET=webcomponent vite build",
    "build:types": "tsc -p tsconfig.build.json && node scripts/finalize-types.mjs",
    "build:notices": "node scripts/gen-notices.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && node scripts/check-lint-rules.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:live": "node --env-file-if-exists=.env node_modules/.bin/playwright test -c playwright.live.config.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:package": "publint && attw --pack . --profile esm-only",
    "check:consumer": "node scripts/check-consumer.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "example:html": "npm run build && vite --config examples/plain-html/vite.config.ts --open /examples/plain-html/",
    "example:react": "npm run build && vite --config examples/react/vite.config.ts --open",
    "screenshot:examples": "node scripts/screenshot-examples.mjs",
    "gen:catalog": "node scripts/gen-catalog.mjs",
    "test:conformance": "vitest run test/conformance",
    "size": "size-limit",
    "release:check": "node scripts/release-check.mjs",
    "release:stamp": "node scripts/stamp-catalog.mjs",
    "release:hashes": "node scripts/release-hashes.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "release:verify": "node scripts/verify-cdn.mjs",
    "release:smoke": "node scripts/release-unisphere-smoke.mjs"
  },
  "peerDependencies": {
    "@a2ui/react": "^0.14.0",
    "@a2ui/web_core": "^0.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@a2ui/markdown-it": "^0.2.2",
    "@a2ui/react": "^0.14.0",
    "@a2ui/web_core": "^0.14.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@size-limit/file": "^14.2.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@visx/axis": "^4.0.0",
    "@visx/curve": "^4.0.0",
    "@visx/geo": "^4.0.0",
    "@visx/gradient": "^4.0.0",
    "@visx/grid": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/heatmap": "^4.0.0",
    "@visx/hierarchy": "^4.0.0",
    "@visx/legend": "^4.0.0",
    "@visx/point": "^4.0.0",
    "@visx/responsive": "^4.0.0",
    "@visx/sankey": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "@visx/text": "^4.0.0",
    "@visx/tooltip": "^4.0.0",
    "@visx/wordcloud": "^4.0.0",
    "@visx/xychart": "^4.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.0.4",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "publint": "^0.3.25",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "size-limit": "^14.2.0",
    "topojson-client": "^3.1.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.0.10",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vitest": "^5.0.4",
    "zod": "^3.25.76"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "markdown-it": "^14.3.1",
    "linkify-it": "^5.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": [
    "./dist/kaltura-react.mjs",
    "./dist/html-element-stub.mjs",
    "./dist/kaltura-wc.js"
  ]
}
