{
  "name": "Analytics report",
  "description": "The Kaltura Analytics app for one media entry, over a fixed date range. Needs your own Kaltura ids and a session from the host.",
  "exercises": [
    "KalturaAnalytics",
    "KS provider",
    "allowlist"
  ],
  "live": true,
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "analytics",
        "catalogId": "https://kaltura.github.io/a2ui/v3/catalog.json"
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "analytics",
        "components": [
          {
            "id": "root",
            "component": "Card",
            "child": "main"
          },
          {
            "id": "main",
            "component": "Column",
            "children": [
              "heading",
              "widget"
            ]
          },
          {
            "id": "heading",
            "component": "Text",
            "text": "## Analytics report",
            "variant": "body"
          },
          {
            "id": "widget",
            "component": "KalturaAnalytics",
            "partnerId": 1234567,
            "entryId": "0_abc12345",
            "fromDate": "2026-10-01",
            "toDate": "2026-10-31",
            "accessibility": {
              "label": "Entry analytics"
            }
          }
        ]
      }
    }
  ]
}
