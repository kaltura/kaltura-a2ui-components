{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaltura.github.io/a2ui/v1/catalog.json",
  "title": "Kaltura Experience Components Catalog",
  "description": "A2UI catalog for Kaltura Experience Components — Player v7, Flashcards, Media Manager, and more. Freestanding schema with all types inlined. Extends the basic A2UI catalog with rich media components backed by the Kaltura platform.",
  "catalogId": "https://kaltura.github.io/a2ui/v1/catalog.json",
  "x-kaltura-adapters": {
    "description": "Where tier-1 A2UI clients can load the renderers backing this catalog's components. Published from github.com/kaltura/kaltura-a2ui-components. URLs and the web-component SRI hash are filled in at release time by that repo's build-and-release workflow; the v0.1.4/sha384-pUqfEVa89a7W9OV6q/g9e1pEA81E6sNmkAnKuFLMoFNmGJ+r018qwlsRSKxxcRMF placeholders in source are replaced on the tagged commit.",
    "package": "@kaltura/a2ui-react",
    "repository": "https://github.com/kaltura/kaltura-a2ui-components",
    "react": {
      "description": "ESM bundle. React is an external peer — the host provides it. Register the Kaltura components by merging them into the host's catalog (see buildKalturaCatalog / kalturaReactCatalog).",
      "format": "esm",
      "npm": "@kaltura/a2ui-react",
      "cdn": "https://cdn.jsdelivr.net/gh/kaltura/kaltura-a2ui-components@v0.1.4/dist/kaltura-react.mjs",
      "exports": ["kalturaReactCatalog", "buildKalturaCatalog", "loadKalturaCatalog", "kalturaComponentImpls", "kalturaClientFunctions"]
    },
    "webcomponent": {
      "description": "Self-contained IIFE (React inlined, CSS-in-JS). Drop in via <script> on plain-HTML hosts; registers all Kaltura custom elements on load. Verify with the integrity hash.",
      "format": "iife",
      "cdn": "https://cdn.jsdelivr.net/gh/kaltura/kaltura-a2ui-components@v0.1.4/dist/kaltura-wc.js",
      "integrity": "sha384-pUqfEVa89a7W9OV6q/g9e1pEA81E6sNmkAnKuFLMoFNmGJ+r018qwlsRSKxxcRMF",
      "crossorigin": "anonymous",
      "customElements": [
        "kaltura-player",
        "kaltura-flashcards",
        "kaltura-media-manager",
        "kaltura-analytics",
        "kaltura-captions-editor",
        "kaltura-recorder",
        "kaltura-avatar",
        "kaltura-genie-widget",
        "kaltura-content-lab",
        "kaltura-agents-widget",
        "kaltura-vod-avatar-wc",
        "kaltura-chart"
      ]
    }
  },
  "components": {
    "KalturaPlayer": {
      "type": "object",
      "description": "Kaltura Player v7 — full-featured video player with DRM, multi-audio, 30+ plugins, captions, analytics tracking, ad insertion, and cue points. Renders as an iframe.",
      "allOf": [
        { "$ref": "#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "KalturaPlayer" },
            "partnerId": {
              "type": "integer",
              "description": "Kaltura account/partner ID."
            },
            "uiconfId": {
              "type": "integer",
              "description": "Player configuration ID (from KMC Studio or uiConf.list)."
            },
            "entryId": {
              "$ref": "#/$defs/DynamicString",
              "description": "Media entry ID to play."
            },
            "ks": {
              "$ref": "#/$defs/DynamicString",
              "description": "Kaltura Session token for access-controlled content. USER KS (type=0)."
            },
            "autoplay": {
              "$ref": "#/$defs/DynamicBoolean",
              "description": "Auto-start playback. Requires muted=true per browser policy. Default: false.",
              "default": false
            },
            "muted": {
              "$ref": "#/$defs/DynamicBoolean",
              "description": "Start muted. Must be true when autoplay is true. Default: false.",
              "default": false
            },
            "startTime": {
              "$ref": "#/$defs/DynamicNumber",
              "description": "Seek to this position (seconds) on load."
            },
            "clipTo": {
              "$ref": "#/$defs/DynamicNumber",
              "description": "Stop playback at this position (seconds)."
            },
            "aspectRatio": {
              "$ref": "#/$defs/DynamicString",
              "description": "Container aspect ratio (e.g. '16/9', '4/3'). Default: '16/9'.",
              "default": "16/9"
            }
          },
          "required": ["component", "partnerId", "uiconfId", "entryId"]
        }
      ],
      "unevaluatedProperties": false
    },
    "KalturaFlashcards": {
      "type": "object",
      "description": "Kaltura Flashcards — structured content cards with optional video clips for each card. Ideal for study material, topic summaries, and bite-sized learning derived from video content.",
      "allOf": [
        { "$ref": "#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "KalturaFlashcards" },
            "title": {
              "$ref": "#/$defs/DynamicString",
              "description": "Title of the flashcard deck."
            },
            "summary": {
              "$ref": "#/$defs/DynamicString",
              "description": "Brief summary or description of the flashcard deck."
            },
            "cards": {
              "type": "array",
              "description": "Ordered list of flashcard items.",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "$ref": "#/$defs/DynamicString",
                    "description": "Card title (front of card)."
                  },
                  "subtitle": {
                    "$ref": "#/$defs/DynamicString",
                    "description": "Optional subtitle or category label."
                  },
                  "content": {
                    "$ref": "#/$defs/DynamicString",
                    "description": "Markdown body content (back of card)."
                  },
                  "clips": {
                    "type": "array",
                    "description": "Video clips relevant to this card.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "entryId": {
                          "type": "string",
                          "description": "Kaltura media entry ID."
                        },
                        "startTime": {
                          "type": "number",
                          "description": "Clip start time in seconds."
                        },
                        "endTime": {
                          "type": "number",
                          "description": "Clip end time in seconds."
                        },
                        "title": {
                          "type": "string",
                          "description": "Optional clip title."
                        },
                        "thumbnail": {
                          "type": "string",
                          "description": "Optional thumbnail URL for the clip."
                        }
                      },
                      "required": ["entryId", "startTime", "endTime"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["title", "content"],
                "additionalProperties": false
              }
            }
          },
          "required": ["component", "title", "cards"]
        }
      ],
      "unevaluatedProperties": false
    },
    "KalturaMediaManager": {
      "type": "object",
      "description": "Kaltura Media Manager — browsable content library for selecting, previewing, and managing media entries. Supports category-scoped views, selection mode for embedding, and full management mode for content operations.",
      "allOf": [
        { "$ref": "#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "KalturaMediaManager" },
            "partnerId": {
              "type": "integer",
              "description": "Kaltura account/partner ID."
            },
            "ks": {
              "$ref": "#/$defs/DynamicString",
              "description": "Kaltura Session token. ADMIN KS (type=2) for manage mode, USER KS (type=0) for select mode."
            },
            "serverUrl": {
              "$ref": "#/$defs/DynamicString",
              "description": "Kaltura Unisphere CDN URL (e.g. 'https://cdnapisec.kaltura.com')."
            },
            "theme": {
              "type": "string",
              "enum": ["dark", "light"],
              "description": "UI theme mode. Default: follows system preference.",
              "default": "light"
            },
            "mode": {
              "type": "string",
              "enum": ["select", "manage"],
              "description": "Interaction mode. 'select' for content picking, 'manage' for full CRUD operations.",
              "default": "manage"
            },
            "contextType": {
              "type": "string",
              "description": "Type of content scope. Default: 'category'.",
              "default": "category"
            },
            "contextId": {
              "$ref": "#/$defs/DynamicString",
              "description": "ID of the content scope (e.g. category ID to browse)."
            }
          },
          "required": ["component", "partnerId", "ks", "serverUrl"]
        }
      ],
      "unevaluatedProperties": false
    },
    "KalturaAnalytics": {
      "type": "object",
      "description": "Kaltura Analytics Dashboard — embedded KMC analytics iframe with optional entry, report type, and date range filters.",
      "allOf": [
        { "$ref": "#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "KalturaAnalytics" },
            "partnerId": {
              "type": "integer",
              "description": "Kaltura account/partner ID."
            },
            "ks": {
              "$ref": "#/$defs/DynamicString",
              "description": "Kaltura Session token (KMC ADMIN KS required for analytics access)."
            },
            "entryId": {
              "$ref": "#/$defs/DynamicString",
              "description": "Optional media entry ID to pre-filter the report."
            },
            "reportType": {
              "$ref": "#/$defs/DynamicString",
              "description": "Analytics report type to display on load."
            },
            "fromDate": {
              "$ref": "#/$defs/DynamicString",
              "description": "Start date for the analytics date range (ISO 8601 or YYYY-MM-DD)."
            },
            "toDate": {
              "$ref": "#/$defs/DynamicString",
              "description": "End date for the analytics date range (ISO 8601 or YYYY-MM-DD)."
            }
          },
          "required": ["component", "partnerId", "ks"]
        }
      ],
      "unevaluatedProperties": false
    },
    "KalturaCaptionsEditor": {
      "type": "object",
      "description": "Kaltura Caption Studio — full-featured in-browser captions editor for a specific media entry.",
      "allOf": [
        { "$ref": "#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "KalturaCaptionsEditor" },
            "partnerId": {
              "type": "integer",
              "description": "Kaltura account/partner ID."
            },
            "ks": {
              "$ref": "#/$defs/DynamicString",
              "description": "Kaltura Session token with captions edit permission."
            },
            "entryId": {
              "$ref": "#/$defs/DynamicString",
              "description": "Media entry ID whose captions to edit."
            },
            "uiconfId": {
              "type": "integer",
              "description": "Optional uiConf ID for the captions editor player."
            }
          },
          "required": ["component", "partnerId", "ks", "entryId"]
        }
      ],
      "unevaluatedProperties": false
    },
    "KalturaRecorder": {
      "type": "object",
      "description": "Kaltura Express Recorder — in-browser webcam/screen recording widget that uploads directly to the Kaltura account.",
      "allOf": [
        { "$ref": "#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "KalturaRecorder" },
            "partnerId": {
              "type": "integer",
              "description": "Kaltura account/partner ID."
            },
            "ks": {
              "$ref": "#/$defs/DynamicString",
              "description": "Kaltura Session token with media upload permission."
            },
            "uiconfId": {
              "type": "integer",
              "description": "Optional uiConf ID for the recorder widget."
            },
            "category": {
              "$ref": "#/$defs/DynamicString",
              "description": "Category path to assign new recordings to."
            },
            "entryName": {
              "$ref": "#/$defs/DynamicString",
              "description": "Default entry name pre-filled in the recorder."
            },
            "allowScreen": {
              "$ref": "#/$defs/DynamicBoolean",
              "description": "Allow screen capture. Default: true."
            },
            "allowCamera": {
              "$ref": "#/$defs/DynamicBoolean",
              "description": "Allow camera capture. Default: true."
            }
          },
          "required": ["component", "partnerId", "ks"]
        }
      ],
      "unevaluatedProperties": false
    },
    "KalturaAvatar": {
      "type": "object",
      "description": "Kaltura AI Avatar — interactive conversational avatar widget powered by Kaltura's avatar platform.",
      "allOf": [
        { "$ref": "#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "KalturaAvatar" },
            "avatarId": {
              "$ref": "#/$defs/DynamicString",
              "description": "Avatar identifier from the Kaltura Avatar platform."
            },
            "projectId": {
              "$ref": "#/$defs/DynamicString",
              "description": "Optional avatar project ID."
            },
            "language": {
              "$ref": "#/$defs/DynamicString",
              "description": "Avatar language code (e.g. 'en', 'he'). Default: 'en'."
            },
            "autoStart": {
              "$ref": "#/$defs/DynamicBoolean",
              "description": "Auto-start the avatar conversation. Default: false."
            },
            "allowInterrupt": {
              "$ref": "#/$defs/DynamicBoolean",
              "description": "Allow user to interrupt the avatar mid-speech. Default: true."
            }
          },
          "required": ["component", "avatarId"]
        }
      ],
      "unevaluatedProperties": false
    },
    "KalturaGenie": {
      "type": "object",
      "description": "Kaltura Genie — AI-powered content discovery and Q&A widget backed by Unisphere.",
      "allOf": [
        { "$ref": "#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "KalturaGenie" },
            "partnerId": {
              "type": "integer",
              "description": "Kaltura account/partner ID."
            },
            "ks": {
              "$ref": "#/$defs/DynamicString",
              "description": "Kaltura Session token."
            },
            "serverUrl": {
              "$ref": "#/$defs/DynamicString",
              "description": "Kaltura Unisphere CDN URL (e.g. 'https://cdnapisec.kaltura.com')."
            },
            "categoryId": {
              "$ref": "#/$defs/DynamicString",
              "description": "Optional category ID to scope the Genie content context."
            },
            "language": {
              "$ref": "#/$defs/DynamicString",
              "description": "UI language code. Default: 'en'."
            }
          },
          "required": ["component", "partnerId", "ks", "serverUrl"]
        }
      ],
      "unevaluatedProperties": false
    },
    "KalturaContentLab": {
      "type": "object",
      "description": "Kaltura Content Lab — AI-powered content creation and enrichment studio for media entries.",
      "allOf": [
        { "$ref": "#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "KalturaContentLab" },
            "partnerId": {
              "type": "integer",
              "description": "Kaltura account/partner ID."
            },
            "ks": {
              "$ref": "#/$defs/DynamicString",
              "description": "Kaltura Session token."
            },
            "serverUrl": {
              "$ref": "#/$defs/DynamicString",
              "description": "Kaltura Unisphere CDN URL (e.g. 'https://cdnapisec.kaltura.com')."
            },
            "entryId": {
              "$ref": "#/$defs/DynamicString",
              "description": "Optional media entry ID to open Content Lab focused on a specific entry."
            }
          },
          "required": ["component", "partnerId", "ks", "serverUrl"]
        }
      ],
      "unevaluatedProperties": false
    },
    "KalturaAgentsWidget": {
      "type": "object",
      "description": "Kaltura AI Agents Widget — embedded Kaltura AI agents interface via Unisphere.",
      "allOf": [
        { "$ref": "#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "KalturaAgentsWidget" },
            "partnerId": {
              "type": "integer",
              "description": "Kaltura account/partner ID."
            },
            "ks": {
              "$ref": "#/$defs/DynamicString",
              "description": "Kaltura Session token."
            },
            "serverUrl": {
              "$ref": "#/$defs/DynamicString",
              "description": "Kaltura Unisphere CDN URL (e.g. 'https://cdnapisec.kaltura.com')."
            },
            "agentId": {
              "$ref": "#/$defs/DynamicString",
              "description": "Optional agent ID to launch a specific agent."
            }
          },
          "required": ["component", "partnerId", "ks", "serverUrl"]
        }
      ],
      "unevaluatedProperties": false
    },
    "KalturaVodAvatar": {
      "type": "object",
      "description": "Kaltura VOD Avatar — avatar overlay on a video-on-demand entry, powered by Unisphere.",
      "allOf": [
        { "$ref": "#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "KalturaVodAvatar" },
            "partnerId": {
              "type": "integer",
              "description": "Kaltura account/partner ID."
            },
            "ks": {
              "$ref": "#/$defs/DynamicString",
              "description": "Kaltura Session token."
            },
            "serverUrl": {
              "$ref": "#/$defs/DynamicString",
              "description": "Kaltura Unisphere CDN URL (e.g. 'https://cdnapisec.kaltura.com')."
            },
            "entryId": {
              "$ref": "#/$defs/DynamicString",
              "description": "Media entry ID for the VOD content the avatar overlays."
            },
            "avatarStyle": {
              "$ref": "#/$defs/DynamicString",
              "description": "Optional avatar visual style preset."
            }
          },
          "required": ["component", "partnerId", "ks", "serverUrl", "entryId"]
        }
      ],
      "unevaluatedProperties": false
    },
    "KalturaChart": {
      "type": "object",
      "description": "Kaltura Chart — data visualization component supporting 12 chart types: line, bar, area, pie, scatter, geo, wordcloud, treemap, heatmap, radar, sankey, funnel.",
      "allOf": [
        { "$ref": "#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "KalturaChart" },
            "chartType": {
              "type": "string",
              "enum": ["line", "bar", "area", "pie", "scatter", "geo", "wordcloud", "treemap", "heatmap", "radar", "sankey", "funnel"],
              "description": "Chart visualization type."
            },
            "data": {
              "type": "array",
              "items": { "type": "object" },
              "description": "Array of data record objects. Keys used as x/y axes."
            },
            "sourceData": {
              "type": "array",
              "items": { "type": "object" },
              "description": "Full dataset for table/export view when chart shows a summary subset."
            },
            "title": {
              "$ref": "#/$defs/DynamicString",
              "description": "Chart title displayed above the visualization."
            },
            "xKey": {
              "$ref": "#/$defs/DynamicString",
              "description": "Data key for the x-axis / category dimension. Auto-detected if omitted."
            },
            "yKeys": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Data keys for the y-axis / value dimensions. Auto-detected if omitted."
            },
            "yLabels": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Human-readable labels for the yKeys series (legend labels)."
            },
            "xLabel": {
              "$ref": "#/$defs/DynamicString",
              "description": "Label for the x-axis."
            },
            "yLabel": {
              "$ref": "#/$defs/DynamicString",
              "description": "Label for the y-axis."
            },
            "colors": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Optional color overrides for chart series (hex or CSS color strings)."
            },
            "height": {
              "$ref": "#/$defs/DynamicNumber",
              "description": "Chart height in pixels. Default: 300."
            },
            "annotations": {
              "type": "array",
              "description": "Vertical annotation markers on cartesian charts (line, bar, area, scatter).",
              "items": {
                "type": "object",
                "properties": {
                  "x": { "type": "string", "description": "x-axis value to annotate." },
                  "label": { "type": "string", "description": "Annotation label text." },
                  "color": { "type": "string", "description": "Annotation color (hex or CSS). Default: accent color." }
                },
                "required": ["x", "label"],
                "additionalProperties": false
              }
            }
          },
          "required": ["component", "chartType", "data"]
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "$defs": {
    "DataBinding": {
      "type": "object",
      "description": "A reference to a value in the data model via JSON Pointer path.",
      "properties": {
        "path": {
          "type": "string",
          "description": "A JSON Pointer path to a value in the data model."
        }
      },
      "required": ["path"],
      "additionalProperties": false
    },
    "DynamicString": {
      "description": "A string value — either a literal string or a data-binding reference.",
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/$defs/DataBinding" }
      ]
    },
    "DynamicNumber": {
      "description": "A numeric value — either a literal number or a data-binding reference.",
      "oneOf": [
        { "type": "number" },
        { "$ref": "#/$defs/DataBinding" }
      ]
    },
    "DynamicBoolean": {
      "description": "A boolean value — either a literal boolean or a data-binding reference.",
      "oneOf": [
        { "type": "boolean" },
        { "$ref": "#/$defs/DataBinding" }
      ]
    },
    "ComponentId": {
      "type": "string",
      "description": "Unique identifier for a component instance within a surface."
    },
    "AccessibilityAttributes": {
      "type": "object",
      "description": "Attributes for assistive technologies (screen readers, etc.).",
      "properties": {
        "label": {
          "$ref": "#/$defs/DynamicString",
          "description": "Short accessible label (1-3 words) conveying element purpose."
        },
        "description": {
          "$ref": "#/$defs/DynamicString",
          "description": "Additional context provided by assistive technologies."
        }
      },
      "additionalProperties": false
    },
    "ComponentCommon": {
      "type": "object",
      "description": "Base properties shared by all components (from A2UI spec).",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComponentId"
        },
        "accessibility": {
          "$ref": "#/$defs/AccessibilityAttributes"
        }
      },
      "required": ["id"]
    },
    "CatalogComponentCommon": {
      "type": "object",
      "description": "Catalog-level properties shared by all Kaltura components.",
      "properties": {
        "tooltip": {
          "$ref": "#/$defs/DynamicString",
          "description": "Tooltip text shown on hover."
        },
        "visible": {
          "$ref": "#/$defs/DynamicBoolean",
          "description": "Controls component visibility.",
          "default": true
        }
      }
    },
    "anyComponent": {
      "oneOf": [
        { "$ref": "#/components/KalturaPlayer" },
        { "$ref": "#/components/KalturaFlashcards" },
        { "$ref": "#/components/KalturaMediaManager" },
        { "$ref": "#/components/KalturaAnalytics" },
        { "$ref": "#/components/KalturaCaptionsEditor" },
        { "$ref": "#/components/KalturaRecorder" },
        { "$ref": "#/components/KalturaAvatar" },
        { "$ref": "#/components/KalturaGenie" },
        { "$ref": "#/components/KalturaContentLab" },
        { "$ref": "#/components/KalturaAgentsWidget" },
        { "$ref": "#/components/KalturaVodAvatar" },
        { "$ref": "#/components/KalturaChart" }
      ]
    },
    "theme": {
      "type": "object",
      "description": "Full theme object for Kaltura surfaces. Includes palette, typography, shape tokens, and flashcard gradients so any A2UI renderer can apply consistent Kaltura branding.",
      "properties": {
        "primaryColor": {
          "type": "string",
          "description": "Primary brand color (hex). Default: Kaltura Stream Blue #006EFA."
        },
        "mode": {
